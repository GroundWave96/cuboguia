    "deploy:manual": "npm run build && wrangler pages deploy dist --project-name cuboguia --branch main"
  },
  "dependencies": {
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@types/three": "^0.169.0",
    "@vitejs/plugin-basic-ssl": "^1.1.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4",
    "wrangler": "^4.40.0"
  }
}
